doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Splash Page
    style.
      body {
        background-color: #f2f2f2;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
      }
      .container {
        text-align: center;
      }
      h1 {
        font-size: 3rem;
        color: #333;
        margin-bottom: 1rem;
      }
      p {
        font-size: 1.5rem;
        color: #666;
      }
  body
    .container
      h1 Welcome to our Splash Page!
      p This is a temporary landing page.
      p Please check back soon for updates.
